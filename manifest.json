{
  "manifest_version": 3,
  "name": "ChatGPT Timekeeper",
  "version": "0.1.0",
  "description": "Adds your browser-local time to outgoing ChatGPT messages.",
  "permissions": ["storage"],
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*"],
    "js": ["content.js"],
    "run_at": "document_start"
  }],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ChatGPT Timekeeper"
  }
}
