{
  "name": "chatgpt-timekeeper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check:build": "node scripts/build.mjs --check",
    "test": "node --test tests/*.test.js",
    "test:browser": "npm run build && playwright test",
    "package": "npm run build && node scripts/package.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "release": "npm run package && npm run verify:package && python3 scripts/release.py"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "prosemirror-history": "1.5.1",
    "prosemirror-model": "1.25.12",
    "prosemirror-state": "1.4.4",
    "prosemirror-view": "1.42.6"
  }
}
